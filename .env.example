# Application
APP_ENV=development

# Database
POSTGRES_DB=minecraft_cloud
POSTGRES_USER=minecraft_cloud
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql://minecraft_cloud:change-me@postgres:5432/minecraft_cloud

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Frontend
VITE_API_BASE_URL=http://localhost:8000

# Minecraft workload defaults
MINECRAFT_DEFAULT_MEMORY=2G
MINECRAFT_DEFAULT_CPU=1.0
MINECRAFT_PORT_RANGE_START=25565
MINECRAFT_PORT_RANGE_END=25665
