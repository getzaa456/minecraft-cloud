# Application
APP_ENV=development

# Database (reserved for a later phase)
POSTGRES_DB=minecraft_cloud
POSTGRES_USER=minecraft_cloud
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql://minecraft_cloud:change-me@postgres:5432/minecraft_cloud

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGIN=http://localhost:5173
DOCKER_SOCKET_PATH=//./pipe/docker_engine

# Frontend
VITE_API_BASE_URL=http://localhost:8000

# Minecraft workload defaults
MINECRAFT_IMAGE=itzg/minecraft-server:stable
MINECRAFT_PORT_RANGE_START=25565
MINECRAFT_PORT_RANGE_END=25665
MINECRAFT_DEFAULT_MEMORY_MB=1024
MINECRAFT_MAX_MEMORY_MB=4096
MINECRAFT_DEFAULT_CPU=1
MINECRAFT_MAX_CPU=2
MINECRAFT_DEFAULT_MAX_PLAYERS=10
