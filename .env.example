# Minecraft Cloud - single project environment file

# Public HTTP port exposed by Caddy
HTTP_PORT=80

# Browser origin allowed by the API
# Use http://localhost for the Compose deployment.
# For direct backend development with Vite, change this to http://localhost:5173.
CORS_ORIGIN=http://localhost

# PostgreSQL
POSTGRES_DB=minecraft_cloud
POSTGRES_USER=minecraft_cloud
POSTGRES_PASSWORD=change-me

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Docker access for direct local backend development on Windows Docker Desktop.
# The Compose deployment overrides this with DOCKER_HOST via the socket proxy.
DOCKER_SOCKET_PATH=//./pipe/docker_engine

# Minecraft workload defaults
MINECRAFT_IMAGE=itzg/minecraft-server:stable
MINECRAFT_PORT_RANGE_START=25565
MINECRAFT_PORT_RANGE_END=25665
MINECRAFT_DEFAULT_MEMORY_MB=1024
MINECRAFT_MAX_MEMORY_MB=4096
MINECRAFT_DEFAULT_CPU=1
MINECRAFT_MAX_CPU=2
MINECRAFT_DEFAULT_MAX_PLAYERS=10

# Monitoring
GRAFANA_PORT=3001
GRAFANA_ADMIN_PASSWORD=change-me
