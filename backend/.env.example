BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGIN=http://localhost:5173

# Docker Desktop on Windows. On Linux use /var/run/docker.sock.
DOCKER_SOCKET_PATH=//./pipe/docker_engine

# Minecraft workload settings
MINECRAFT_IMAGE=itzg/minecraft-server:stable
MINECRAFT_PORT_RANGE_START=25565
MINECRAFT_PORT_RANGE_END=25665
MINECRAFT_DEFAULT_MEMORY_MB=1024
MINECRAFT_MAX_MEMORY_MB=4096
MINECRAFT_DEFAULT_CPU=1
MINECRAFT_MAX_CPU=2
MINECRAFT_DEFAULT_MAX_PLAYERS=10
