# Public HTTP port for Caddy
HTTP_PORT=80

# Browser origin allowed by the API. For local Compose deployment this is http://localhost.
CORS_ORIGIN=http://localhost

# PostgreSQL
POSTGRES_DB=minecraft_cloud
POSTGRES_USER=minecraft_cloud
POSTGRES_PASSWORD=change-me

# Minecraft workload defaults
MINECRAFT_IMAGE=itzg/minecraft-server:stable
MINECRAFT_PORT_RANGE_START=25565
MINECRAFT_PORT_RANGE_END=25665
MINECRAFT_DEFAULT_MEMORY_MB=1024
MINECRAFT_DEFAULT_CPU=1
MINECRAFT_MAX_MEMORY_MB=4096
MINECRAFT_MAX_CPU=2
MINECRAFT_DEFAULT_MAX_PLAYERS=10
