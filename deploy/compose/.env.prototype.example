# Copy this file to .env.prototype before running the Phase 1 prototype.

MINECRAFT_PROTOTYPE_PORT=25565
MINECRAFT_VERSION=LATEST
MINECRAFT_JVM_MEMORY=1G
MINECRAFT_CONTAINER_MEMORY_LIMIT=1536M
MINECRAFT_CPU_LIMIT=1.0
MINECRAFT_MAX_PLAYERS=10
MINECRAFT_MOTD=Minecraft Cloud Prototype
MINECRAFT_DIFFICULTY=normal
MINECRAFT_RCON_PASSWORD=change-me-local-only
